<?xml version='1.0' encoding='UTF-8'?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:id="@+id/main" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@drawable/bg_voltify_screen">
  <ScrollView android:layout_width="0dp" android:layout_height="0dp" android:id="@+id/scrollContent" app:layout_constraintTop_toTopOf="parent" app:layout_constraintBottom_toBottomOf="parent" app:layout_constraintStart_toStartOf="parent" app:layout_constraintEnd_toEndOf="parent">
  <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="20dp">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:orientation="horizontal">
      <ImageView android:layout_width="34dp" android:layout_height="42dp" android:src="@drawable/ic_voltify_bolt" android:contentDescription="@string/app_name"/>
      <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="8dp" android:text="@string/app_name" android:textColor="@color/voltify_text_primary" android:textSize="27sp" android:textStyle="bold"/>
    </LinearLayout>
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:text="@string/devices_title" android:textColor="@color/voltify_text_primary" android:textSize="26sp" android:textStyle="bold"/>
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/devices_sub_v9" android:textColor="@color/voltify_text_secondary"/>

    <EditText android:id="@+id/etBuscarArtefacto" android:layout_width="match_parent" android:layout_height="50dp" android:layout_marginTop="12dp" android:background="@drawable/bg_input" android:hint="@string/search_devices_hint" android:textColor="@color/voltify_text_primary" android:textColorHint="@color/voltify_text_muted"/>

    <HorizontalScrollView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp">
      <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="horizontal">
        <Button android:id="@+id/btnFiltroTodos" android:layout_width="wrap_content" android:layout_height="44dp" android:text="@string/todos" android:textAllCaps="false"/>
        <Button android:id="@+id/btnFiltroMonitoreando" android:layout_width="wrap_content" android:layout_height="44dp" android:text="@string/monitoring_filter" android:textAllCaps="false"/>
        <Button android:id="@+id/btnFiltroDetenidos" android:layout_width="wrap_content" android:layout_height="44dp" android:text="@string/stopped_filter" android:textAllCaps="false"/>
        <Button android:id="@+id/btnFiltroRetirados" android:layout_width="wrap_content" android:layout_height="44dp" android:text="@string/retirados" android:textAllCaps="false"/>
      </LinearLayout>
    </HorizontalScrollView>

    <Button android:id="@+id/btnAgregar" android:layout_width="match_parent" android:layout_height="54dp" android:layout_marginTop="10dp" android:background="@drawable/bg_button_primary" android:backgroundTint="@null" android:text="@string/add_device" android:textAllCaps="false" android:textColor="@color/voltify_text_primary"/>
    <LinearLayout android:id="@+id/llArtefactos" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical"/>
    <Button android:id="@+id/btnVolver" android:layout_width="match_parent" android:layout_height="52dp" android:layout_marginTop="12dp" android:background="@drawable/bg_button_outline" android:backgroundTint="@null" android:text="@string/back" android:textAllCaps="false" android:textColor="@color/voltify_bright_blue"/>
  </LinearLayout>
</ScrollView>
</androidx.constraintlayout.widget.ConstraintLayout>
