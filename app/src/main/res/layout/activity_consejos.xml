<?xml version='1.0' encoding='UTF-8'?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:id="@+id/main" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@drawable/bg_voltify_screen">
  <ScrollView android:layout_width="0dp" android:layout_height="0dp" android:id="@+id/scrollContent" app:layout_constraintTop_toTopOf="parent" app:layout_constraintBottom_toBottomOf="parent" app:layout_constraintStart_toStartOf="parent" app:layout_constraintEnd_toEndOf="parent">

    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="20dp">

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:orientation="horizontal">

            <ImageView android:layout_width="34dp" android:layout_height="42dp" android:contentDescription="@string/app_name" android:src="@drawable/ic_voltify_bolt"/>

            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="8dp" android:text="@string/app_name" android:textColor="@color/voltify_text_primary" android:textSize="27sp" android:textStyle="bold"/>
        </LinearLayout>

        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="14dp" android:text="@string/consejos_inteligentes" android:textColor="@color/voltify_text_primary" android:textSize="25sp" android:textStyle="bold"/>

        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/voltify_analiza_tu_consumo_mensual_tus_metas_y_el_estado_de_monitoreo" android:textColor="@color/voltify_text_secondary"/>

        <LinearLayout android:id="@+id/panelResumenConsejos" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="14dp" android:background="@drawable/bg_panel" android:orientation="vertical" android:padding="14dp">

            <TextView android:id="@+id/tvPeriodoConsejos" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="@color/voltify_cyan" android:textSize="13sp" android:textStyle="bold"/>

            <TextView android:id="@+id/tvResumenConsejos" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:textColor="@color/voltify_text_secondary" android:textSize="13sp"/>
        </LinearLayout>

        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="18dp" android:text="@string/recomendaciones_para_ti" android:textColor="@color/voltify_text_primary" android:textSize="18sp" android:textStyle="bold"/>

        <LinearLayout android:id="@+id/llConsejosPersonalizados" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical"/>

        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="20dp" android:text="@string/buenas_practicas_generales" android:textColor="@color/voltify_text_primary" android:textSize="18sp" android:textStyle="bold"/>

        <LinearLayout android:id="@+id/llConsejosGenerales" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical"/>

        <Button android:id="@+id/btnVolver" android:layout_width="match_parent" android:layout_height="52dp" android:layout_marginTop="18dp" android:background="@drawable/bg_button_outline" android:backgroundTint="@null" android:text="@string/back" android:textAllCaps="false" android:textColor="@color/voltify_bright_blue"/>
    </LinearLayout>
</ScrollView>
</androidx.constraintlayout.widget.ConstraintLayout>
