<?xml version='1.0' encoding='UTF-8'?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:id="@+id/main" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@drawable/bg_voltify_screen">
  <ScrollView android:layout_width="0dp" android:layout_height="0dp" android:fillViewport="true" android:id="@+id/scrollContent" app:layout_constraintTop_toTopOf="parent" app:layout_constraintBottom_toBottomOf="parent" app:layout_constraintStart_toStartOf="parent" app:layout_constraintEnd_toEndOf="parent">
<LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="24dp">

<LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:orientation="horizontal">
    <ImageView android:layout_width="34dp" android:layout_height="42dp" android:src="@drawable/ic_voltify_bolt" android:contentDescription="@string/app_name"/>
    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="8dp" android:text="@string/app_name" android:textColor="@color/voltify_text_primary" android:textSize="27sp" android:textStyle="bold"/>
</LinearLayout>

<TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="22dp" android:text="@string/register_title" android:textColor="@color/voltify_text_primary" android:textSize="28sp" android:textStyle="bold"/>
<TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="5dp" android:text="@string/register_subtitle" android:textColor="@color/voltify_text_secondary" android:textSize="14sp"/>
<LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="20dp" android:background="@drawable/bg_panel" android:orientation="vertical" android:padding="18dp">
<EditText android:id="@+id/etNombre" android:layout_width="match_parent" android:layout_height="54dp" android:layout_marginTop="12dp" android:background="@drawable/bg_input" android:hint="@string/full_name" android:inputType="textPersonName" android:paddingLeft="16dp" android:paddingRight="16dp" android:textColor="@color/voltify_text_primary" android:textColorHint="@color/voltify_text_muted" android:textSize="15sp"/>
<EditText android:id="@+id/etCorreo" android:layout_width="match_parent" android:layout_height="54dp" android:layout_marginTop="12dp" android:background="@drawable/bg_input" android:hint="@string/email" android:inputType="textEmailAddress" android:paddingLeft="16dp" android:paddingRight="16dp" android:textColor="@color/voltify_text_primary" android:textColorHint="@color/voltify_text_muted" android:textSize="15sp"/>
<EditText android:id="@+id/etTelefono" android:layout_width="match_parent" android:layout_height="54dp" android:layout_marginTop="12dp" android:background="@drawable/bg_input" android:hint="@string/phone" android:inputType="phone" android:paddingLeft="16dp" android:paddingRight="16dp" android:textColor="@color/voltify_text_primary" android:textColorHint="@color/voltify_text_muted" android:textSize="15sp"/>
<AutoCompleteTextView android:id="@+id/acComuna" android:layout_width="match_parent" android:layout_height="54dp" android:layout_marginTop="12dp" android:background="@drawable/bg_input" android:hint="@string/commune" android:inputType="none" android:paddingLeft="16dp" android:paddingRight="16dp" android:textColor="@color/voltify_text_primary" android:textColorHint="@color/voltify_text_muted"/>
<AutoCompleteTextView android:id="@+id/acEmpresa" android:layout_width="match_parent" android:layout_height="54dp" android:layout_marginTop="12dp" android:background="@drawable/bg_input" android:hint="@string/company" android:inputType="none" android:paddingLeft="16dp" android:paddingRight="16dp" android:textColor="@color/voltify_text_primary" android:textColorHint="@color/voltify_text_muted"/>
<EditText android:id="@+id/etContrasena" android:layout_width="match_parent" android:layout_height="54dp" android:layout_marginTop="12dp" android:background="@drawable/bg_input" android:hint="@string/password" android:inputType="textPassword" android:paddingLeft="16dp" android:paddingRight="16dp" android:textColor="@color/voltify_text_primary" android:textColorHint="@color/voltify_text_muted" android:textSize="15sp"/>
<TextView android:id="@+id/tvPasswordPolicy" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="@string/password_policy" android:textColor="@color/voltify_text_secondary" android:textSize="12sp"/>
<EditText android:id="@+id/etConfirmar" android:layout_width="match_parent" android:layout_height="54dp" android:layout_marginTop="12dp" android:background="@drawable/bg_input" android:hint="@string/confirm_password" android:inputType="textPassword" android:paddingLeft="16dp" android:paddingRight="16dp" android:textColor="@color/voltify_text_primary" android:textColorHint="@color/voltify_text_muted" android:textSize="15sp"/>
<Button android:id="@+id/btnRegistrar" android:layout_width="match_parent" android:layout_height="54dp" android:layout_marginTop="16dp" android:background="@drawable/bg_button_primary" android:backgroundTint="@null" android:text="@string/register" android:textAllCaps="false" android:textColor="@color/voltify_text_primary" android:textSize="16sp" android:textStyle="bold"/>
<TextView android:id="@+id/tvVolverLogin" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_gravity="center_horizontal" android:layout_marginTop="16dp" android:padding="5dp" android:text="@string/back_login" android:textColor="@color/voltify_cyan" android:textStyle="bold"/>
</LinearLayout></LinearLayout></ScrollView>
</androidx.constraintlayout.widget.ConstraintLayout>
