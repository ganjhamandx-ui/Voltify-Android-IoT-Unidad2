<?xml version='1.0' encoding='UTF-8'?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:id="@+id/main" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@drawable/bg_voltify_screen">
  <ScrollView android:layout_width="0dp" android:layout_height="0dp" android:id="@+id/scrollContent" app:layout_constraintTop_toTopOf="parent" app:layout_constraintBottom_toBottomOf="parent" app:layout_constraintStart_toStartOf="parent" app:layout_constraintEnd_toEndOf="parent">
  <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="20dp">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:orientation="horizontal">
      <ImageView android:layout_width="34dp" android:layout_height="42dp" android:src="@drawable/ic_voltify_bolt" android:contentDescription="@string/app_name"/>
      <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="8dp" android:text="@string/app_name" android:textColor="@color/voltify_text_primary" android:textSize="27sp" android:textStyle="bold"/>
    </LinearLayout>
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="14dp" android:text="@string/goals_title" android:textColor="@color/voltify_text_primary" android:textSize="25sp" android:textStyle="bold"/>
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:background="@drawable/bg_panel" android:orientation="vertical" android:padding="14dp">
      <TextView android:id="@+id/tvEstadoMeta" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="@color/voltify_text_secondary"/>
      <ProgressBar android:id="@+id/pbMeta" style="?android:attr/progressBarStyleHorizontal" android:layout_width="match_parent" android:layout_height="8dp" android:layout_marginTop="12dp" android:max="100"/>
      <TextView android:id="@+id/tvProgreso" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:textColor="@color/voltify_cyan"/>
      <EditText android:id="@+id/etMetaKwh" android:layout_width="match_parent" android:layout_height="54dp" android:layout_marginTop="14dp" android:background="@drawable/bg_input" android:hint="@string/goal_kwh" android:inputType="numberDecimal" android:textColor="@color/voltify_text_primary" android:textColorHint="@color/voltify_text_muted"/>
      <EditText android:id="@+id/etMetaClp" android:layout_width="match_parent" android:layout_height="54dp" android:layout_marginTop="10dp" android:background="@drawable/bg_input" android:hint="@string/goal_clp" android:inputType="numberDecimal" android:textColor="@color/voltify_text_primary" android:textColorHint="@color/voltify_text_muted"/>
      <Button android:id="@+id/btnGuardarMeta" android:layout_width="match_parent" android:layout_height="54dp" android:layout_marginTop="12dp" android:background="@drawable/bg_button_primary" android:backgroundTint="@null" android:text="@string/guardar_actualizar_meta" android:textAllCaps="false" android:textColor="@color/voltify_text_primary"/>
      <Button android:id="@+id/btnEliminarMeta" android:layout_width="match_parent" android:layout_height="50dp" android:layout_marginTop="8dp" android:background="@drawable/bg_button_outline" android:backgroundTint="@null" android:text="@string/eliminar_meta_mensual" android:textAllCaps="false" android:textColor="@color/voltify_danger"/>
    </LinearLayout>
    <Button android:id="@+id/btnVolver" android:layout_width="match_parent" android:layout_height="52dp" android:layout_marginTop="12dp" android:background="@drawable/bg_button_outline" android:backgroundTint="@null" android:text="@string/back" android:textAllCaps="false" android:textColor="@color/voltify_bright_blue"/>
  </LinearLayout>
</ScrollView>
</androidx.constraintlayout.widget.ConstraintLayout>
