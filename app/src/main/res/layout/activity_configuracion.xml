<?xml version='1.0' encoding='UTF-8'?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:id="@+id/main" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@drawable/bg_voltify_screen">
  <ScrollView android:layout_width="0dp" android:layout_height="0dp" android:fillViewport="true" android:scrollbars="vertical" android:fadeScrollbars="false" android:overScrollMode="ifContentScrolls" android:id="@+id/scrollContent" app:layout_constraintTop_toTopOf="parent" app:layout_constraintBottom_toBottomOf="parent" app:layout_constraintStart_toStartOf="parent" app:layout_constraintEnd_toEndOf="parent">

    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:paddingLeft="20dp" android:paddingTop="20dp" android:paddingRight="20dp" android:paddingBottom="36dp">

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:orientation="horizontal">

            <ImageView android:layout_width="34dp" android:layout_height="42dp" android:contentDescription="@string/app_name" android:src="@drawable/ic_voltify_bolt"/>

            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="8dp" android:text="@string/app_name" android:textColor="@color/voltify_text_primary" android:textSize="27sp" android:textStyle="bold"/>
        </LinearLayout>

        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="18dp" android:text="@string/config_title" android:textColor="@color/voltify_text_primary" android:textSize="28sp" android:textStyle="bold"/>

        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:text="@string/config_sub" android:textColor="@color/voltify_text_secondary"/>

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="18dp" android:background="@drawable/bg_panel" android:orientation="vertical" android:padding="18dp">

            <EditText android:id="@+id/etNombre" android:layout_width="match_parent" android:layout_height="54dp" android:background="@drawable/bg_input" android:hint="@string/full_name" android:inputType="textPersonName" android:paddingLeft="16dp" android:paddingRight="16dp" android:textColor="@color/voltify_text_primary" android:textColorHint="@color/voltify_text_muted" android:textSize="15sp"/>

            <EditText android:id="@+id/etCorreo" android:layout_width="match_parent" android:enabled="false" android:focusable="false" android:layout_height="54dp" android:layout_marginTop="12dp" android:background="@drawable/bg_input" android:hint="@string/email" android:inputType="textEmailAddress" android:paddingLeft="16dp" android:paddingRight="16dp" android:textColor="@color/voltify_text_primary" android:textColorHint="@color/voltify_text_muted" android:textSize="15sp"/>
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:text="@string/email_change_security_note" android:textColor="@color/voltify_text_muted" android:textSize="11sp"/>

            <EditText android:id="@+id/etTelefono" android:layout_width="match_parent" android:layout_height="54dp" android:layout_marginTop="12dp" android:background="@drawable/bg_input" android:hint="@string/phone" android:inputType="phone" android:paddingLeft="16dp" android:paddingRight="16dp" android:textColor="@color/voltify_text_primary" android:textColorHint="@color/voltify_text_muted" android:textSize="15sp"/>

            <AutoCompleteTextView android:id="@+id/acComuna" android:layout_width="match_parent" android:layout_height="54dp" android:layout_marginTop="12dp" android:background="@drawable/bg_input" android:hint="@string/commune" android:inputType="none" android:paddingLeft="16dp" android:paddingRight="16dp" android:textColor="@color/voltify_text_primary" android:textColorHint="@color/voltify_text_muted" android:textSize="15sp"/>

            <AutoCompleteTextView android:id="@+id/acEmpresa" android:layout_width="match_parent" android:layout_height="54dp" android:layout_marginTop="12dp" android:background="@drawable/bg_input" android:hint="@string/company" android:inputType="none" android:paddingLeft="16dp" android:paddingRight="16dp" android:textColor="@color/voltify_text_primary" android:textColorHint="@color/voltify_text_muted" android:textSize="15sp"/>

            <TextView android:id="@+id/tvTarifaActual" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:background="@drawable/bg_panel_soft" android:padding="12dp" android:textColor="@color/voltify_cyan"/>

            <CheckBox android:id="@+id/cbTarifaManual" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="14dp" android:text="@string/manual_rate" android:textColor="@color/voltify_text_primary"/>

            <EditText android:id="@+id/etKwh" android:layout_width="match_parent" android:layout_height="54dp" android:layout_marginTop="12dp" android:background="@drawable/bg_input" android:hint="@string/kwh_value" android:inputType="numberDecimal" android:paddingLeft="16dp" android:paddingRight="16dp" android:textColor="@color/voltify_text_primary" android:textColorHint="@color/voltify_text_muted" android:textSize="15sp"/>

            <EditText android:id="@+id/etCargoFijo" android:layout_width="match_parent" android:layout_height="54dp" android:layout_marginTop="12dp" android:background="@drawable/bg_input" android:hint="@string/fixed_charge" android:inputType="numberDecimal" android:paddingLeft="16dp" android:paddingRight="16dp" android:textColor="@color/voltify_text_primary" android:textColorHint="@color/voltify_text_muted" android:textSize="15sp"/>

            <Button android:id="@+id/btnGuardar" android:layout_width="match_parent" android:layout_height="54dp" android:layout_marginTop="16dp" android:background="@drawable/bg_button_primary" android:backgroundTint="@null" android:text="@string/save_changes" android:textAllCaps="false" android:textColor="@color/voltify_text_primary" android:textSize="16sp" android:textStyle="bold"/>
        </LinearLayout>

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:background="@drawable/bg_panel" android:orientation="vertical" android:padding="16dp">

            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/sync_status" android:textColor="@color/voltify_text_primary" android:textStyle="bold"/>

            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="@string/sync_api" android:textColor="@color/voltify_warning"/>

            <TextView android:id="@+id/tvEstadoFirebase" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:text="@string/sync_rtdb" android:textColor="@color/voltify_warning"/>

            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:text="@string/sync_secure_local" android:textColor="@color/voltify_success"/>

            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:text="@string/sync_iot" android:textColor="@color/voltify_warning"/>
        </LinearLayout>

        <Button android:id="@+id/btnVolver" android:layout_width="match_parent" android:layout_height="52dp" android:layout_marginTop="16dp" android:background="@drawable/bg_button_outline" android:backgroundTint="@null" android:text="@string/back_dashboard" android:textAllCaps="false" android:textColor="@color/voltify_bright_blue"/>

        <Button android:id="@+id/btnCerrarSesion" android:layout_width="match_parent" android:layout_height="52dp" android:layout_marginTop="10dp" android:layout_marginBottom="8dp" android:background="@drawable/bg_button_outline" android:backgroundTint="@null" android:text="@string/logout" android:textAllCaps="false" android:textColor="@color/voltify_danger"/>

    </LinearLayout>
</ScrollView>
</androidx.constraintlayout.widget.ConstraintLayout>
