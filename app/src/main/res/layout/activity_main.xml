<?xml version='1.0' encoding='UTF-8'?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:id="@+id/main" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@drawable/bg_voltify_screen">
  <ScrollView android:layout_width="0dp" android:layout_height="0dp" android:fillViewport="true" android:id="@+id/scrollContent" app:layout_constraintTop_toTopOf="parent" app:layout_constraintBottom_toBottomOf="parent" app:layout_constraintStart_toStartOf="parent" app:layout_constraintEnd_toEndOf="parent">
  <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="640dp" android:gravity="center_vertical" android:orientation="vertical" android:padding="24dp">

<LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:orientation="horizontal">
    <ImageView android:layout_width="34dp" android:layout_height="42dp" android:src="@drawable/ic_voltify_bolt" android:contentDescription="@string/app_name"/>
    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="8dp" android:text="@string/app_name" android:textColor="@color/voltify_text_primary" android:textSize="27sp" android:textStyle="bold"/>
</LinearLayout>

    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="28dp" android:text="@string/login_title" android:textColor="@color/voltify_text_primary" android:textSize="30sp" android:textStyle="bold"/>
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:text="@string/login_subtitle" android:textColor="@color/voltify_text_secondary" android:textSize="14sp"/>
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="28dp" android:background="@drawable/bg_panel" android:orientation="vertical" android:padding="18dp">
      <EditText android:id="@+id/etCorreo" android:layout_width="match_parent" android:layout_height="54dp" android:layout_marginTop="12dp" android:background="@drawable/bg_input" android:hint="@string/email" android:inputType="textEmailAddress" android:paddingLeft="16dp" android:paddingRight="16dp" android:textColor="@color/voltify_text_primary" android:textColorHint="@color/voltify_text_muted" android:textSize="15sp"/>
      <EditText android:id="@+id/etContrasena" android:layout_width="match_parent" android:layout_height="54dp" android:layout_marginTop="12dp" android:background="@drawable/bg_input" android:hint="@string/password" android:inputType="textPassword" android:paddingLeft="16dp" android:paddingRight="16dp" android:textColor="@color/voltify_text_primary" android:textColorHint="@color/voltify_text_muted" android:textSize="15sp"/>
      <TextView android:id="@+id/tvRecuperarContrasena" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_gravity="end" android:layout_marginTop="10dp" android:padding="4dp" android:text="@string/forgot_password" android:textColor="@color/voltify_cyan" android:textSize="13sp" android:textStyle="bold"/>
      <Button android:id="@+id/btnIngresar" android:layout_width="match_parent" android:layout_height="54dp" android:layout_marginTop="16dp" android:background="@drawable/bg_button_primary" android:backgroundTint="@null" android:text="@string/enter" android:textAllCaps="false" android:textColor="@color/voltify_text_primary" android:textSize="16sp" android:textStyle="bold"/>
      <TextView android:id="@+id/tvCrearCuenta" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_gravity="center_horizontal" android:layout_marginTop="18dp" android:padding="6dp" android:text="@string/create_account" android:textColor="@color/voltify_cyan" android:textSize="14sp" android:textStyle="bold"/>
    </LinearLayout>
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="18dp" android:gravity="center" android:text="@string/demo_note" android:textColor="@color/voltify_text_muted" android:textSize="11sp"/>
  </LinearLayout>
</ScrollView>
</androidx.constraintlayout.widget.ConstraintLayout>
